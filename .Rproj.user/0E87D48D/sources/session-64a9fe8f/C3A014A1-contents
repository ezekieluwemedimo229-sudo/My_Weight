```{r}
# readline reads a single line of code entered by a user.
# readline(prompt = "")

name <- readline("Enter your name: ")
age <- as.numeric(readline("Enter your age: "))
weight <- as.numeric(readline("Enter your weight in kg: "))

height_feet <- as.numeric(readline("Enter your height in feet: "))
height_inches <- as.numeric(readline("Enter the remaining inches: "))


calculate_bmi <- function(weight, height_feet, height_inches) {
  
  # Convert feet to metres
  feet_m <- height_feet * 0.3048
  
  # Convert inches to metres
  inches_m <- height_inches * 0.0254
  
  # Add both to get total height in metres
  height_m <- feet_m + inches_m
  
  # Calculate BMI
  bmi <- weight / (height_m^2)
  
  return(bmi)
}


bmi <- calculate_bmi(weight, height_feet, height_inches)


if (bmi < 18.5) {
  category <- "Underweight"
} else if (bmi < 25) {
  category <- "Normal weight"
} else if (bmi < 30) {
  category <- "Overweight"
} else {
  category <- "Obesity"
}


cat("Hello", name, "!\n")
cat("Your BMI is:", round(bmi, 2), "\n")
cat("BMI Category:", category, "\n")
```


